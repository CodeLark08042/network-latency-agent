# ---------------------------------------------------------------------------
# CLI (Ollama, local model)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b

# ---------------------------------------------------------------------------
# Web backend (DeepSeek, OpenAI-compatible endpoint)
# Leave DEEPSEEK_API_KEY empty to run the offline rule fallback (source=mock).
# You can also paste a key in the web page; it is sent only to your local backend.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com